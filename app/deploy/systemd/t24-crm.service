[Unit]
Description=T24 CRM FastAPI service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/t24-crm/backend
EnvironmentFile=/opt/t24-crm/.env.production
Environment=PYTHONPATH=/opt/t24-crm/backend
ExecStart=/opt/t24-crm/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips='*'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
