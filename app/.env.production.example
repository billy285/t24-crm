# Copy this file to .env.production on the server and fill real values.

APP_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# Required: use a long random value. Example command:
# openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Domain used by the browser. Replace with your real HTTPS domain.
FRONTEND_ORIGINS=https://crm.example.com
PYTHON_BACKEND_URL=https://crm.example.com

# SQLite is OK for small internal use. Keep ./data backed up every day.
DATABASE_URL=sqlite:///./data/crm_prod.db

# Default admin seeding is intentionally disabled by default.
# To create a first admin on a clean production database, temporarily set:
# ENABLE_DEFAULT_EMPLOYEE_ADMIN=true
# DEFAULT_ADMIN_EMAIL=your-admin@example.com
# DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
# Then start once, confirm login, and disable ENABLE_DEFAULT_EMPLOYEE_ADMIN again.
ENABLE_DEFAULT_EMPLOYEE_ADMIN=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
ALLOW_WEAK_DEFAULT_ADMIN=false

# Optional integrations
MASK_KEY=replace-with-a-long-random-mask-key
OPENAI_API_KEY=
OPENAI_BASE_URL=
STRIPE_SECRET_KEY=
OSS_SERVICE_URL=
OSS_API_KEY=

# Cookie settings when behind HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Re-check employee status and role from the database on every protected request.
# Keep enabled so disabled or deleted accounts lose access immediately.
ENFORCE_EMPLOYEE_STATUS=true

# Employee login abuse protection (per account and source IP).
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Enable only when the upstream reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# Production must use database migrations; never repair auth schema at request time.
ALLOW_RUNTIME_SCHEMA_REPAIR=false
